APP_NAME="Xinghuo Fire Agent Backend"
APP_VERSION="0.1.0"
ENVIRONMENT=development
API_PREFIX=/api

HOST=0.0.0.0
PORT=8200

# Leave DATABASE_URL empty to use SQLite at ./data/fire_agent_backend.db.
DATABASE_URL=
DATABASE_ECHO=false

CORS_ORIGINS=*

# Development default. MiMo can be enabled later by changing these values.
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.6
LLM_API_KEY=
LLM_BASE_URL=
