APP_NAME="Xinghuo Fire Agent Backend"
APP_VERSION="0.1.0"
ENVIRONMENT=development
API_PREFIX=/api

HOST=0.0.0.0
PORT=8200

# Team baseline: use PostgreSQL/PostGIS. SQLite remains available only for a lightweight local smoke test.
DATABASE_URL=postgresql+asyncpg://xinghuo:xinghuo_dev@localhost:5432/xinghuo
DATABASE_ECHO=false
LANDSCAPE_DATA_DIR=../environment

CORS_ORIGINS=["*"]

# Development default. MiMo can be enabled later by changing these values.
LLM_PROVIDER=structured
LLM_MODEL=structured-command-rules
LLM_API_KEY=
LLM_BASE_URL=
# Qwen-VL visual verification. Keep the real key outside Git.
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_VL_TIMEOUT_SECONDS=60
QWEN_VL_MAX_ATTEMPTS=2
QWEN_VL_MAX_IMAGE_BYTES=10485760

FOREFIRE_API_URL=http://127.0.0.1:5000
FOREFIRE_TIMEOUT_SECONDS=300
