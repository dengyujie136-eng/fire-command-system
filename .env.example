VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
# Keep these empty for same-origin access through the Vite/Nginx proxy.
VITE_FIRE_AGENT_API_BASE_URL=
VITE_FIRE_AGENT_WS_BASE_URL=

# Docker Compose development defaults. Change the password before shared deployment.
POSTGRES_DB=xinghuo
POSTGRES_USER=xinghuo
POSTGRES_PASSWORD=xinghuo_dev

LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.6
LLM_API_KEY=
LLM_BASE_URL=

# Qwen-VL is required for the complete visual fire-point workflow.
# Obtain a DashScope key and keep the real value only in the local .env file.
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_VL_TIMEOUT_SECONDS=60
QWEN_VL_MAX_ATTEMPTS=2
QWEN_VL_MAX_IMAGE_BYTES=10485760
